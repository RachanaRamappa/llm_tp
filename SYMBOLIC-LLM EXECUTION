LLM_BASE_URL = os.getenv("LLM_BASE_URL", "http://localhost:8000/v1")
LLM_API_KEY = os.getenv("LLM_API_KEY", "local-key")
DEFAULT_MODEL = os.getenv("LLM_MODEL", "Qwen/Qwen3-32B")


def get_session_completion(
    chat_history,
    model="qwen3:8b",
    max_tokens=2048,
    temperature=0.0,
    logprobs=False,
    top_logprobs=None
):
    client = OpenAI(
        base_url="http://localhost:11434/v1",
        api_key="ollama"
    )

    response = client.chat.completions.create(
        model=model,
        messages=chat_history,
        max_tokens=max_tokens,
        temperature=temperature,
        logprobs=logprobs,
        top_logprobs=top_logprobs,
        extra_body={"think": False}
    )

    result = response.model_dump()

    message = result["choices"][0]["message"]

    content = message.get("content", "")

    # Qwen3 may return reasoning separately.
    reasoning = message.get("reasoning", "")

    # For now, we only want the actual answer.
    if not content and reasoning:
        print("WARNING: Model returned reasoning but no content.")

    print("LLM CONTENT:", repr(content))
    print("LLM FINISH:", result["choices"][0].get("finish_reason"))

    # --------------------------------------------------------
    # If the model reaches the token limit, ask it to continue
    # --------------------------------------------------------

    if result["choices"][0]["finish_reason"] == "length":

        assistant_content = result["choices"][0]["message"].get(
            "content", ""
        )

        chat_history.append({
            "role": "assistant",
            "content": assistant_content
        })

        chat_history.append({
            "role": "user",
            "content": "Continue."
        })

        # Second request
        next_response = client.chat.completions.create(
           model=model,
           messages=chat_history,
           max_tokens=max_tokens,
           temperature=temperature,
           logprobs=logprobs,
           top_logprobs=top_logprobs,
           extra_body={"think": False}
        )

        next_result = next_response.model_dump()

        next_content = next_result["choices"][0]["message"].get(
            "content", ""
        )

        # Combine both responses
        result["choices"][0]["message"]["content"] = (
            assistant_content + "\n" + next_content
        )
        
        return result
    return result


